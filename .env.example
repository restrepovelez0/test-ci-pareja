# Copia estas variables en Vercel → Settings → Environment Variables.
# Clave que piden la web y la API. Compártela solo con tu pareja.
APP_PIN=
# Nombres de la pareja, separados por coma.
PEOPLE=Sebas,Laura

# Las agrega Vercel solo al conectar Upstash (Marketplace → Upstash Redis):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (también sirven UPSTASH_REDIS_REST_URL y UPSTASH_REDIS_REST_TOKEN)

# La agrega Vercel solo al crear un Blob store (Storage → Blob):
# BLOB_READ_WRITE_TOKEN=

# Pon SEED=off si no quieres que se carguen los lugares de ejemplo la primera vez.
# SEED=off
